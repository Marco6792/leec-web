# ─── Database (direct Postgres connection used by Drizzle) ────────────────
DATABASE_URL=

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — required to create auth users for new lab members
# (used by /admin/lab-members new-member flow and scripts/create-director.ts)
SUPABASE_SERVICE_ROLE_KEY=

# ─── UploadThing (image uploads: profile photos + entity images) ───────────
# Get a token from https://uploadthing.com/dashboard
# The app ID is embedded in the token (UploadThing v7).
UPLOADTHING_TOKEN=
