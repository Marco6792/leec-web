# ─── Supabase ─────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database ─────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# Can use the connection pooler: postgres://user:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Site URL (for auth redirects) ────────────────────────────────────────
# Used by Supabase Auth to redirect after login/OAuth/email confirmation
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
